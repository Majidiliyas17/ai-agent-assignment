# ---------------------------------------------------------------------------
# AI Lead & Patient Intake Pipeline - environment configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- LLM (Gemini) -----------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any currently available Gemini Flash model id (free-tier friendly).
GEMINI_MODEL=gemini-3.6-flash
# Provider selection: "gemini" (default, requires GEMINI_API_KEY)
#                     "offline" (deterministic local rules, NO LLM - demo only)
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- Downstream mock CMS ----------------------------------------------------
CMS_BASE_URL=http://localhost:8000
CMS_DB_PATH=./output/mock_cms.sqlite3

# --- Source A: LinkedIn-style CSV leads -------------------------------------
# Leave empty to auto-discover data/mock_leads*.csv
LEADS_CSV_PATH=

# --- Source B: SMART Health IT synthetic FHIR R4 sandbox --------------------
FHIR_BASE_URL=https://r4.smarthealthit.org
# Must be >= 15 (assignment requirement).
FHIR_PATIENT_COUNT=20
# Optional enrichment: fetch Condition resources per patient (0.5s+ extra).
FHIR_FETCH_CONDITIONS=false

# --- Resilience -------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
